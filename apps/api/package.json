{
  "name": "car-buddy-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "start": "node dist/src/main.js",
    "dev": "tsc -p . && (tsc -w -p . --preserveWatchOutput & node --watch dist/src/main.js)",
    "models": "tsc -p . && node dist/scripts/list-models.js",
    "smoke:extract": "tsc -p . && node dist/scripts/smoke-extract.js",
    "db:up": "docker compose -f ../../docker-compose.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsc -p . && node dist/scripts/seed.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "@vercel/functions": "^3.11.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "openai": "^7.64.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}

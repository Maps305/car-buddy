PORT=3000

DATABASE_URL=postgres://carbuddy:carbuddy@localhost:5432/carbuddy

# Signs staff portal sessions; any random string of 32+ characters (e.g. openssl rand -base64 48)
JWT_SECRET=
# Password given to every account in data/demo-staff.json when you run db:seed
SEED_STAFF_PASSWORD=

CAIMEX_API_KEY=
CAIMEX_BASE_URL=https://api.caimex.ai/v1
CAIMEX_AGENT_MODEL=caimex/auto
CAIMEX_EXTRACTION_MODEL=gemini-3.6-flash
CAIMEX_TIMEOUT_MS=60000

# Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value into the webhook config in Meta
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard > App settings > Basic > App secret
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
# Local testing only; ignored when NODE_ENV=production
WHATSAPP_SKIP_SIGNATURE=false

MEDIA_DIR=./storage/media
DEMO_CUSTOMERS_FILE=./data/demo-customers.json
